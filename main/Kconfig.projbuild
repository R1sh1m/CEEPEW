menu "CEE-PEW Configuration"

    config CEEPEW_DEVELOPMENT_MODE
        bool "Development Mode (enables tests, debug serial, headless mode)"
        default n
        help
            Master toggle that enables the internal test suite under tests/
            (auto-run on boot, prints === DIAGNOSTIC REPORT ===), enables
            CEEPEW_DEBUG_SERIAL for operational-status logging (never key
            material), and enables CEEPEW_HEADLESS_MODE for UI auto-advance
            without OLED (uses hardcoded session code "ZZZZ"). Production
            builds MUST leave this disabled (default).

    menu "Hardware Pin Configuration"

        menu "OLED Display (I2C) Pins"

            config CEEPEW_PIN_I2C_SDA
                int "Primary I2C SDA GPIO Pin"
                default 26
                range 0 39
                help
                    GPIO pin number assigned to primary I2C SDA (default: 26).

            config CEEPEW_PIN_I2C_SCL
                int "Primary I2C SCL GPIO Pin"
                default 27
                range 0 39
                help
                    GPIO pin number assigned to primary I2C SCL (default: 27).

            config CEEPEW_PIN_I2C_SDA_FALLBACK
                int "Fallback I2C SDA GPIO Pin"
                default 21
                range 0 39
                help
                    GPIO pin number assigned to fallback I2C SDA (default: 21).

            config CEEPEW_PIN_I2C_SCL_FALLBACK
                int "Fallback I2C SCL GPIO Pin"
                default 22
                range 0 39
                help
                    GPIO pin number assigned to fallback I2C SCL (default: 22).

        endmenu

        menu "RGB LED Pins"

            config CEEPEW_PIN_RGB_RED
                int "RGB Red LED GPIO Pin"
                default 15
                range 0 39
                help
                    GPIO pin number assigned to RGB LED Red channel (default: 15).

            config CEEPEW_PIN_RGB_GREEN
                int "RGB Green LED GPIO Pin"
                default 18
                range 0 39
                help
                    GPIO pin number assigned to RGB LED Green channel (default: 18).

            config CEEPEW_PIN_RGB_BLUE
                int "RGB Blue LED GPIO Pin"
                default 23
                range 0 39
                help
                    GPIO pin number assigned to RGB LED Blue channel (default: 23).

        endmenu

        menu "Inputs & Switches Pins"

            config CEEPEW_PIN_POT
                int "Rotary Potentiometer GPIO Pin (ADC1 only)"
                default 33
                range 0 39
                help
                    GPIO pin number assigned to rotary potentiometer analog input (default: 33).
                    Must be an ADC1 pin (GPIO 32..39).

            config CEEPEW_PIN_BUTTON
                int "Click Button GPIO Pin"
                default 19
                range 0 39
                help
                    GPIO pin number assigned to primary click button (default: 19).

            config CEEPEW_PIN_DIAG_SWITCH
                int "Diagnostic Switch GPIO Pin"
                default 5
                range 0 39
                help
                    GPIO pin number assigned to diagnostic push-lock switch (default: 5).

        endmenu

    endmenu

    menu "Advanced Options"

        config CEEPEW_EFUSE_HMAC_KEY
            bool "Enable eFuse HMAC device identity key"
            default n
            help
                Store a 32-byte device identity key in the ESP32 eFuse user
                data block (EFUSE_BLK3) and use it to derive a device-bound
                HKDF salt during session key derivation. Falls back to
                software-only salt if eFuse block is unprovisioned.

        config CEEPEW_WIFI_FULL_RESTART
            bool "Full WiFi stop+start on BLE->WiFi transition"
            default y
            help
                When enabled (default), performs full esp_wifi_stop()/esp_wifi_start()
                to force coexistence hardware reset after BLE deinit.
                When disabled, uses coex_schm_process_restart() as lighter alternative.

        config CEEPEW_OLED_FORCE_SH1106
            bool "Force SH1106 mode (column offset +2)"
            default n
            help
                Force the OLED driver to use SH1106 initialization and column
                addressing (+2 column offset). Enable if your board hardware uses an
                SH1106 controller instead of SSD1306.

        config CEEPEW_CAPTURE
            bool "Enable on-node promiscuous OTA capture (Phase 3 debug)"
            default n
            help
                Start a WiFi promiscuous-mode sniffer (MGMT filter, ESP-NOW
                vendor OUI 18:fe:34) after BLE teardown when entering
                ESP-NOW Phase 3, plus a low-priority logger task that prints
                ts/rssi/ch/len/hex per frame. Consume the logger output at
                921600 baud host-side. Debug only — normal builds leave this
                disabled (default).

        choice CEEPEW_CAPTURE_LINK_MODE
            prompt "Capture bench link mode (logger build only)"
            depends on CEEPEW_CAPTURE
            default CEEPEW_CAPTURE_MODE_CEEPEW
            help
                Selects the over-the-air link mode used by the capture bench
                build. Both bench devices MUST be flashed with the same mode
                (reflash per mode). Has no effect when CEEPEW_CAPTURE is
                disabled: the choice is invisible and production behavior
                (LMK-registered peer + ESL Ascon) is untouched.

            config CEEPEW_CAPTURE_MODE_PLAIN
                bool "Mode A: plain ESP-NOW (no CCMP, no ESL)"
                help
                    Register the peer WITHOUT an LMK (peer.encrypt=false) and
                    bypass the ESL/Ascon application crypto entirely — the
                    message payload is on air in cleartext for Wireshark
                    inspection of the raw ESP-NOW vendor frames.

            config CEEPEW_CAPTURE_MODE_CCMP
                bool "Mode B: ESP-NOW CCMP only (industry-standard baseline)"
                help
                    Register the peer WITH an LMK (peer.encrypt=true) and
                    bypass the ESL/Ascon application crypto — only the
                    hardware CCMP layer encrypts the frame (industry-standard
                    802.11 baseline for the capture comparison).

            config CEEPEW_CAPTURE_MODE_CEEPEW
                bool "Mode C: CEE-PEW full stack (ESL Ascon, no CCMP)"
                help
                    Register the peer WITHOUT an LMK (peer.encrypt=false) and
                    keep the ESL Ascon stack ACTIVE — pure CEE-PEW over
                    unencrypted vendor frames (matches the hal_radio.c
                    peer-registration design comment).

        endchoice

        config CEEPEW_BENCH_58B
            bool "Enable scripted 58-byte Full-stack TX campaign (bench only)"
            default n
            help
                When enabled, an active headless session emits scripted
                58-byte Full-stack frames (counter pattern) every 5 s, up to
                80 frames, tagged [BENCH58_TX]/[BENCH58_DONE] for host-side
                latency analysis. Used to re-measure Full-mode TX timing
                (Table VI). Disabled in production (default).

        config CEEPEW_BENCH_TIMING
            bool "Enable sync-pulse timing instrumentation (E5)"
            default n
            depends on CEEPEW_BENCH_58B
            help
                Enable microsecond-resolution sync-pulse instrumentation for
                one-way OTA latency measurement. Uses GPIO14 as a shared wire
                between both boards (open-drain with pull-up). Both boards
                transmit AND receive during BENCH58 campaigns.

        config CEEPEW_PIN_SYNC
            int "Sync pulse GPIO (shared wire, both boards)"
            default 14
            range 0 39
            depends on CEEPEW_BENCH_TIMING
            help
                GPIO pin number for the sync pulse wire. Both boards use the
                same pin (GPIO14 by default) connected directly together.
                Configured as open-drain with internal pull-up.

        config CEEPEW_FEC_DISABLE
            bool "Disable Hamming(15,11) FEC (reliability ablation only)"
            default n
            help
                Compile-time FEC ablation switch for the reliability study.
                Leave DISABLED (default, production): the TX pipeline
                Hamming-encodes each fragment before appending the inner CRC-32,
                and the RX pipeline Hamming-decodes (single-bit correction)
                after the CRC check. Enable to compile FEC OUT: frames then carry
                the payload + inner CRC-32 only (smaller on air, no error
                correction). BOTH devices MUST be flashed with the same setting,
                since the wire framing differs.

    endmenu

endmenu
