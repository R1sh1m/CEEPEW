# CEE-PEW Production Configuration
# Phase 4: Real-usage firmware (no permanent eFuse burning)
#
# This is the configuration for the firmware a real user interacts with:
# development mode is OFF (no headless auto-advance, no on-board test suite,
# real UI + session flow), but ALL features that permanently burn eFuses
# (Secure Boot v2, Flash Encryption, eFuse HMAC) are intentionally removed
# by design decision. Boards flashed with this config remain reusable.
#
# DO NOT re-add secure boot / flash encryption here without a dedicated
# provisioning process — they burn one-way eFuses on the target hardware.

include sdkconfig.defaults

# Development mode MUST be off for production (real-usage) firmware.
CONFIG_CEEPEW_DEVELOPMENT_MODE=n

# eFuse HMAC key binding was intentionally dropped by design decision.
# Device-binding via eFuse is no longer part of the production security layer.

# Secure Boot v2 and Flash Encryption are intentionally NOT enabled:
# both burn one-way eFuses on first boot. Removed by design decision so the
# firmware can be flashed and iterated on without permanently locking boards.
