# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.0.2 Project Minimal Configuration
#
CONFIG_CEEPEW_DEVELOPMENT_MODE=n
# Physical flash on the target dev boards is 4 MB (DevKit v1). The previously
# stamped 2 MB header produced "Detected size(4096k) larger than the size in
# the binary image header" on every boot. eFuse HMAC binding is intentionally
# dropped (design decision), so CEEPEW_EFUSE_HMAC_KEY stays off.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# CEEPEW_OLED_FORCE_SH1106 is not set — the hardware is SSD1306 (RG0.96 IC V2.0).
# SH1106 init uses a different charge pump command (0xAD,0x8B instead of 0x8D,0x14)
# which prevents the SSD1306 internal DC-DC converter from activating, resulting in
# a blank display. See DEBUG_LOG_OLED_I2C.md.
# CONFIG_CEEPEW_OLED_FORCE_SH1106 is not set

# Prevent third-party component warnings (e.g. arduino-esp32 C++ libraries) from breaking builds on newer IDF/GCC versions
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# esp32-arduino requires 1000 Hz FreeRTOS tick rate
CONFIG_FREERTOS_HZ=1000

# Bluetooth / BLE Configuration (Bluedroid required for Phases 1-2 Discovery + Pairing)
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

